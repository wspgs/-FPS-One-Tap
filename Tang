---Show or hide the menu window.
local function toggleMenu()
	if not window then
		return
	end

	-- Prefer the real window state so it stays in sync with the keybind.
	local hasState, state = pcall(function()
		return window:GetState()
	end)
	if hasState and type(state) == "boolean" then
		menuVisible = state
	end

	menuVisible = not menuVisible

	local success = pcall(function()
		window:SetState(menuVisible)
	end)

	-- Fall back to pressing the menu keybind ourselves.
	if not success and keytap then
		keytap(MENU_KEY_CODE)
	end
end

---Create a small draggable button that toggles the menu (works on touch too).
local function buildToggleButton()
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "TangHubToggle"
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = 999
	screenGui.Parent = gethui and gethui() or game:GetService("CoreGui")

	table.insert(ByteHub.restorers, function()
		screenGui:Destroy()
	end)

	local button = Instance.new("TextButton")
	button.Size = UDim2.fromOffset(44, 44)
	button.Position = UDim2.new(0, 12, 0.5, -22)
	button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	button.BackgroundTransparency = 0.15
	button.Text = "TH"
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.TextSize = 16
	button.Font = Enum.Font.GothamBold
	button.Parent = screenGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = button

	local dragging, moved = false, false
	local dragStart, startPosition

	-- Tap toggles the menu, dragging moves the button.
	connect(button.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		dragging, moved = true, false
		dragStart, startPosition = input.Position, button.Position
	end)

	connect(userInputService.InputChanged, function(input)
		if not dragging then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		local delta = input.Position - dragStart
		if delta.Magnitude > 4 then
			moved = true
		end

		button.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end)

	connect(userInputService.InputEnded, function(input)
		if not dragging then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		dragging = false
		if not moved then
			toggleMenu()
		end
	end)
end

---Detach everything and restore the game state.
function ByteHub.detach()
	ByteHub.running = false

	for _, connection in ipairs(ByteHub.connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	for _, object in ipairs(ByteHub.drawings) do
		pcall(function()
			object:Remove()
		end)
	end

	for model in pairs(chamObjects) do
		pcall(function()
			chamObjects[model]:Destroy()
		end)
	end

	for _, restore in ipairs(ByteHub.restorers) do
		pcall(restore)
	end

	Config.fullbright, Config.noFog = false, false
	pcall(applyLighting)

	if window then
		pcall(function()
			window:Unload()
		end)
	end
end

---This is called when initialization errors.
---@param error string
local function onInitializeError(error)
	warn("Failed to initialize.")
	warn(error)
	warn(debug.traceback())
	ByteHub.detach()
end

---Install hooks, build the menu and start the loops.
local function initializeScript()
	refreshEntities()

	-- Each hook is independent, one failing must not block the others.
	local hooks = {
		function()
			fastCastHooked = installFastCastHook()
		end,
		installNamecallHook,
		installIndexHook,
	}

	for _, install in ipairs(hooks) do
		local success, message = pcall(install)
		if not success then
			warn("[ByteHub] hook failed: " .. tostring(message))
		end
	end

	local success, message = pcall(buildMenu)
	if not success then
		warn("[ByteHub] menu failed, using defaults: " .. tostring(message))
	elseif window then
		pcall(buildToggleButton)
	end

	connect(runService.RenderStepped, function()
		local ok, result = pcall(onRenderStep)
		if not ok and result ~= lastError then
			lastError = result
			warn("[ByteHub] render error: " .. tostring(result))
		end
	end)

	connect(runService.Stepped, updateNoclip)

	connect(userInputService.JumpRequest, function()
		local character = localPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if Config.infJump and humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end)

	connect(localPlayer.Idled, function()
		if Config.antiAfk then
			virtualUser:CaptureController()
			virtualUser:ClickButton2(Vector2.new())
		end
	end)

	task.spawn(function()
		while ByteHub.running do
			refreshEntities()
			task.wait(ENTITY_REFRESH)
		end
	end)

	diagnose()
end

-- Safely initialize the script as well as handle errors.
shared.ByteHub = ByteHub
xpcall(initializeScript, onInitializeError)
