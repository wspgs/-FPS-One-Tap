---Create the Drawing objects used by ESP for a model.
---@param model Model
local function createEsp(model)
	local box = newDrawing("Square")
	box.Thickness = 1
	box.Filled = false

	local name = newDrawing("Text")
	name.Size = 13
	name.Center = true
	name.Outline = true

	local healthBack = newDrawing("Line")
	healthBack.Thickness = 4
	healthBack.Color = Color3.new(0, 0, 0)

	local healthBar = newDrawing("Line")
	healthBar.Thickness = 2

	local tracer = newDrawing("Line")
	tracer.Thickness = 1

	espObjects[model] = { box = box, name = name, healthBack = healthBack, healthBar = healthBar, tracer = tracer }
end

---Remove ESP objects of a model.
---@param model Model
local function removeEsp(model)
	local objects = espObjects[model]
	if objects then
		for _, object in pairs(objects) do
			pcall(function()
				object:Remove()
			end)
		end
		espObjects[model] = nil
	end

	local cham = chamObjects[model]
	if cham then
		cham:Destroy()
		chamObjects[model] = nil
	end
end

---Show or hide a highlight on a model.
---@param model Model
---@param visible boolean
local function updateCham(model, visible)
	local cham = chamObjects[model]
	if not visible then
		if cham then
			cham.Enabled = false
		end
		return
	end

	if not cham then
		cham = Instance.new("Highlight")
		cham.FillTransparency = 0.5
		cham.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		cham.Parent = gethui and gethui() or game:GetService("CoreGui")
		chamObjects[model] = cham
	end

	cham.Adornee = model
	cham.FillColor = Config.espColor
	cham.OutlineColor = Config.espColor
	cham.Enabled = true
end

---Draw ESP for every enemy model.
local function updateEsp()
	local camera = getCamera()
	local present = {}

	-- Sync ESP objects with the entity list.
	for _, model in ipairs(entities) do
		present[model] = true
		if not espObjects[model] then
			createEsp(model)
		end
	end

	for model in pairs(espObjects) do
		if not present[model] then
			removeEsp(model)
		end
	end

	local viewport = camera.ViewportSize

	for model, objects in pairs(espObjects) do
		for _, object in pairs(objects) do
			object.Visible = false
		end

		local humanoid, root = getAlive(model)
		local valid = Config.espEnabled and humanoid ~= nil
		local distance = valid and (root.Position - camera.CFrame.Position).Magnitude or 0
		if valid and distance > Config.maxDist then
			valid = false
		end

		updateCham(model, valid and Config.espChams)
		if not valid then
			continue
		end

		local screenPos, onScreen = camera:WorldToViewportPoint(root.Position)
		if not onScreen then
			continue
		end

		local top = camera:WorldToViewportPoint(root.Position + Vector3.new(0, 2.6, 0))
		local bottom = camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3.2, 0))
		local height = math.abs(bottom.Y - top.Y)
		local width = height * 0.55
		local boxX = screenPos.X - width / 2
		local color = Config.espColor

		if Config.espBox then
			objects.box.Size = Vector2.new(width, height)
			objects.box.Position = Vector2.new(boxX, top.Y)
			objects.box.Color = color
			objects.box.Visible = true
		end

		if Config.espName then
			objects.name.Text = string.format("%s [%dm]", model.Name, distance)
			objects.name.Position = Vector2.new(screenPos.X, top.Y - 16)
			objects.name.Color = color
			objects.name.Visible = true
		end

		if Config.espHealth then
			local ratio = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
			local x = boxX - 5
			objects.healthBack.From = Vector2.new(x, top.Y + height)
			objects.healthBack.To = Vector2.new(x, top.Y)
			objects.healthBack.Visible = true

			objects.healthBar.From = Vector2.new(x, top.Y + height)
			objects.healthBar.To = Vector2.new(x, top.Y + height - height * ratio)
			objects.healthBar.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), ratio)
			objects.healthBar.Visible = true
		end

		if Config.espTracer then
			objects.tracer.From = Vector2.new(viewport.X / 2, viewport.Y)
			objects.tracer.To = Vector2.new(screenPos.X, top.Y + height)
			objects.tracer.Color = color
			objects.tracer.Visible = true
		end
	end
end

---Apply or restore lighting changes.
local function applyLighting()
	if Config.fullbright then
		lightingService.Brightness = 2
		lightingService.ClockTime = 14
		lightingService.GlobalShadows = false
		lightingService.Ambient = Color3.fromRGB(200, 200, 200)
		appliedFullbright = true
	elseif appliedFullbright then
		lightingService.Brightness = originalLighting.Brightness
		lightingService.ClockTime = originalLighting.ClockTime
		lightingService.GlobalShadows = originalLighting.GlobalShadows
		lightingService.Ambient = originalLighting.Ambient
		appliedFullbright = false
	end

	if Config.noFog then
		lightingService.FogEnd = 1e6
		appliedNoFog = true
	elseif appliedNoFog then
		lightingService.FogEnd = originalLighting.FogEnd
		appliedNoFog = false
	end
end

---Apply character and camera modifications.
local function updateMisc()
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		if Config.speedEnabled then
			humanoid.WalkSpeed = Config.speedValue
		end

		if Config.jumpEnabled then
			humanoid.UseJumpPower = true
			humanoid.JumpPower = Config.jumpValue
		end
	end

	if Config.fovEnabled then
		getCamera().FieldOfView = Config.fovValue
	end

	applyLighting()
end

---Disable collisions on the local character.
local function updateNoclip()
	local character = localPlayer.Character
	if not (Config.noclip and character) then
		return
	end

	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.CanCollide then
			part.CanCollide = false
		end
	end
end

---Run every per-frame feature, errors are reported once.
local function onRenderStep()
	updateSilent()
	updateCircle()
	updateEsp()
	updateMisc()
end

---Print a quick health report to help debugging.
local function diagnose()
	local actorCount = 0
	if getactors then
		actorCount = actorCount + #getactors()
	end
	if getdeletedactors then
		actorCount = actorCount + #getdeletedactors()
	end

	local weaponVisible = false
	local success, modules = pcall(getloadedmodules)
	if success then
		for _, module in ipairs(modules) do
			if module.Name == WEAPON_SOURCE then
				weaponVisible = true
				break
			end
		end
	end

	print(
		string.format(
			"[ByteHub] entities=%d actors=%d weaponClientVisible=%s fastCastHooked=%s",
			#entities,
			actorCount,
			tostring(weaponVisible),
			tostring(fastCastHooked)
		)
	)
end

---Add a toggle bound to a Config key.
local function addToggle(section, name, key, onChanged)
	section:Toggle({
		Name = name,
		Default = Config[key],
		Callback = function(value)
			Config[key] = value
			if onChanged then
				onChanged(value)
			end
		end,
	}, key)
end

---Add a slider bound to a Config key.
local function addSlider(section, name, key, minimum, maximum, precision)
	section:Slider({
		Name = name,
		Default = Config[key],
		Minimum = minimum,
		Maximum = maximum,
		DisplayMethod = "Value",
		Precision = precision or 0,
		Callback = function(value)
			Config[key] = value
		end,
	}, key)
end

---Add a dropdown bound to a Config key.
local function addDropdown(section, name, key, options)
	section:Dropdown({
		Name = name,
		Options = options,
		Default = table.find(options, Config[key]) or 1,
		Multi = false,
		Required = true,
		Callback = function(value)
			Config[key] = value
		end,
	}, key)
end

---Add a color picker bound to a Config key.
local function addColor(section, name, key)
	section:Colorpicker({
		Name = name,
		Default = Config[key],
		Callback = function(value)
			Config[key] = value
		end,
	}, key)
end

