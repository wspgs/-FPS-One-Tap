end

---Track a connection so detach can clean it.
---@param signal RBXScriptSignal
---@param callback function
local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(ByteHub.connections, connection)
	return connection
end

---Create a Drawing object that detach can remove.
---@param className string
local function newDrawing(className)
	local object = Drawing.new(className)
	table.insert(ByteHub.drawings, object)
	return object
end

---Load Data2Code once (outside of any hook, since request yields).
local function loadSerializer()
	if serializer then
		return
	end

	local success, response = pcall(request, { Url = DATA2CODE_URL, Method = "GET" })
	if not (success and response and response.Success) then
		return
	end

	local loaded = loadstring(response.Body)
	if loaded then
		serializer = loaded()
	end
end

---Print which hook layer redirected a shot.
---@param layer string
local function debugLog(layer, ...)
	if not Config.debug then
		return
	end

	if serializer then
		return print("[ByteHub] redirect via " .. layer, serializer.Convert({ ... }, true))
	end

	print("[ByteHub] redirect via " .. layer)
end

---Check if a character belongs to a teammate.
---@param model Model
local function isTeammate(model)
	if not Config.teamCheck then
		return false
	end

	local player = playersService:GetPlayerFromCharacter(model)
	return player ~= nil and player.Team ~= nil and player.Team == localPlayer.Team
end

---Rebuild the list of enemy models (real players plus bots in Workspace).
local function refreshEntities()
	table.clear(entities)
	local seen = {}
	local localCharacter = localPlayer.Character

	for _, player in ipairs(playersService:GetPlayers()) do
		local character = player.Character
		if player == localPlayer or not character or seen[character] then
			continue
		end

		seen[character] = true
		if not isTeammate(character) then
			table.insert(entities, character)
		end
	end

	for _, model in ipairs(workspace:GetChildren()) do
		if seen[model] or model == localCharacter or not model:IsA("Model") then
			continue
		end

		if model:FindFirstChildOfClass("Humanoid") and model:FindFirstChild("HumanoidRootPart") then
			table.insert(entities, model)
		end
	end
end

---Return humanoid and root if the model is alive.
---@param model Model
local function getAlive(model)
	if not (model and model.Parent) then
		return nil
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root and humanoid.Health > 0) then
		return nil
	end

	return humanoid, root
end

---Check if a part is unobstructed from the camera.
---@param part BasePart
---@param model Model
local function isVisible(part, model)
	local camera = getCamera()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { localPlayer.Character, camera, workspace:FindFirstChild("Effects") }

	local origin = camera.CFrame.Position
	local result = workspace:Raycast(origin, part.Position - origin, params)
	return result == nil or result.Instance:IsDescendantOf(model)
end

---Return the closest valid part to the cursor inside the silent FOV.
---@return BasePart?, BasePart?
local function getSilentTarget()
	local camera = getCamera()
	local mousePos = userInputService:GetMouseLocation()
	local bestPart, bestRoot, bestDist = nil, nil, Config.silentFov

	for _, model in ipairs(entities) do
		local humanoid, root = getAlive(model)
		if not humanoid then
			continue
		end

		if Config.ignoreForceField and model:FindFirstChildOfClass("ForceField") then
			continue
		end

		local part = model:FindFirstChild(Config.silentPart) or root
		if (root.Position - camera.CFrame.Position).Magnitude > Config.maxDist then
			continue
		end

		local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
		if not onScreen then
			continue
		end

		local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
		if dist > bestDist then
			continue
		end

		if Config.silentWall and not isVisible(part, model) then
			continue
		end

		bestPart, bestRoot, bestDist = part, root, dist
	end

	return bestPart, bestRoot
end

---Pick the silent target and auto fire when enabled.
local function updateSilent()
	silentPosition, silentPart = nil, nil
	if not Config.silentEnabled then
		return
	end

	local part, root = getSilentTarget()
	if not part then
		return
	end

	if math.random(1, 100) > Config.silentHitChance then
		return
	end

	silentPart = part
	silentPosition = part.Position + root.AssemblyLinearVelocity * Config.silentPrediction

	-- Auto fire needs the game window focused.
	if Config.triggerBot and mouse1click and os.clock() - lastTrigger > TRIGGER_DELAY then
		lastTrigger = os.clock()
		mouse1click()
	end
end

---Point a direction at the silent target while keeping its length.
---@param origin Vector3
---@param direction Vector3
local function redirect(origin, direction)
	local offset = silentPosition - origin
	if offset.Magnitude < 0.001 then
		return direction
	end

	return offset.Unit * math.max(direction.Magnitude, 1)
end

---Check that the running code was called from the weapon script.
local function isWeaponCaller()
	local callingScript = getcallingscript and getcallingscript()
	if callingScript and string.find(callingScript.Name, WEAPON_SOURCE, 1, true) then
		return true
	end

	for level = 2, 10 do
		if not debug.isvalidlevel(level) then
			break
		end

		local success, source = pcall(debug.info, level, "s")
		if success and source and string.find(source, WEAPON_SOURCE, 1, true) then
			return true
		end
	end

	return false
end

---Hook FastCast:Fire so bullets spawn toward the target.
local function installFastCastHook()
	local container = replicatedStorage
	for _, name in ipairs(FASTCAST_PATH) do
		container = container and container:FindFirstChild(name)
	end

	if not container then
		return false
	end

	-- Drop identity so the game module cannot see our environment.
	setthreadidentity(2)
	local success, fastCast = pcall(require, container)
	setthreadidentity(8)

	if not success or type(fastCast) ~= "table" or type(fastCast.Fire) ~= "function" then
		return false
	end

	local oldFire
	oldFire = hookfunction(fastCast.Fire, newcclosure(function(self, origin, direction, ...)
		if ByteHub.running and silentPosition and typeof(origin) == "Vector3" and typeof(direction) == "Vector3" then
			if isWeaponCaller() then
				debugLog("FastCast", origin, direction)
				return oldFire(self, origin, redirect(origin, direction), ...)
			end
		end

		return oldFire(self, origin, direction, ...)
	end))

	table.insert(ByteHub.restorers, function()
		restorefunction(fastCast.Fire)
	end)

	return true
end

---Hook Raycast and ViewportPointToRay calls made by the weapon script.
local function installNamecallHook()
	local oldNamecall
	oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		if not ByteHub.running or not silentPosition or checkcaller() then
			return oldNamecall(self, ...)
		end

		local method = getnamecallmethod()

		if method == "Raycast" and self == workspace then
			local origin, direction = ...
			if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" and isWeaponCaller() then
				debugLog("Raycast", origin, direction)
				return oldNamecall(self, origin, redirect(origin, direction), select(3, ...))
			end
		elseif method == "ViewportPointToRay" or method == "ScreenPointToRay" then
			if self == getCamera() and isWeaponCaller() then
				local ray = oldNamecall(self, ...)
				debugLog(method, ray)
				return Ray.new(ray.Origin, redirect(ray.Origin, ray.Direction).Unit)
			end
		end

		return oldNamecall(self, ...)
	end))
end

---Hook Mouse.Hit and Mouse.Target reads made by the weapon script.
local function installIndexHook()
	local oldIndex
	oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
		if key ~= "Hit" and key ~= "Target" then
			return oldIndex(self, key)
		end

		if not ByteHub.running or not silentPosition or checkcaller() or self ~= mouse then
			return oldIndex(self, key)
		end

		if not isWeaponCaller() then
			return oldIndex(self, key)
		end

		debugLog("Mouse." .. key)
		if key == "Hit" then
			return CFrame.new(silentPosition)
		end

		return silentPart
	end))
end

